{
  "info": {
    "name": "PharmaSaaS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for the PharmaSaaS backend. Uses {{root_url}} for public routes and {{api_base_url}} for authenticated API routes."
  },
  "variable": [
    { "key": "root_url", "value": "http://localhost:9090" },
    { "key": "api_base_url", "value": "http://localhost:9090/api" },
    { "key": "jwt_token", "value": "" },
    { "key": "pharmacie_id", "value": "" },
    { "key": "pharmacien_id", "value": "" },
    { "key": "fournisseur_id", "value": "" },
    { "key": "medicament_id", "value": "" },
    { "key": "vente_id", "value": "" },
    { "key": "plan_id", "value": "" },
    { "key": "abonnement_id", "value": "" },
    { "key": "payment_id", "value": "" },
    { "key": "payment_url", "value": "" },
    { "key": "dashboard_path", "value": "" },
    { "key": "redirectUrl", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pharmacien@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{root_url}}/auth/login",
              "host": ["{{root_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.environment.set('jwt_token', json.token); }",
                  "if (json.pharmacieId) { pm.environment.set('pharmacie_id', json.pharmacieId); }",
                  "if (json.userId) { pm.environment.set('pharmacien_id', json.userId); }",
                  "if (json.dashboardPath) { pm.environment.set('dashboard_path', json.dashboardPath); pm.environment.set('redirectUrl', 'http://localhost:3000' + json.dashboardPath); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"sara\",\n  \"lastName\": \"ben saleh\",\n  \"email\": \"sara@gmail.com\",\n  \"password\": \"azertyui\",\n  \"pharmacyName\": \"Pharmacie de Sara\",\n  \"pharmacyAddress\": \"123 Rue Principale, Ville\",\n  \"phoneNumber\": \"0600000000\"\n}"
            },
            "url": {
              "raw": "{{root_url}}/auth/register",
              "host": ["{{root_url}}"],
              "path": ["auth", "register"]
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const json = pm.response.json();",
                    "if (json.token) { pm.environment.set('jwt_token', json.token); }",
                    "if (json.pharmacieId) { pm.environment.set('pharmacie_id', json.pharmacieId); }",
                    "if (json.userId) { pm.environment.set('pharmacien_id', json.userId); }",
                    "if (json.dashboardPath) { pm.environment.set('dashboard_path', json.dashboardPath); pm.environment.set('redirectUrl', 'http://localhost:3000' + json.dashboardPath); }"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
